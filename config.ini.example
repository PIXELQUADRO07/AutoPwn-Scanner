# config.ini.example
# ─────────────────────────────────────────────────────────────
# Copy this file to config.ini and customize the values.
#   cp config.ini.example config.ini
#
# config.ini is in .gitignore: it will never be committed.
# ─────────────────────────────────────────────────────────────

[metasploit]
# Password set at msfrpcd startup (-P <password>)
password = CHANGE_THIS_PASSWORD
host     = 127.0.0.1
port     = 55553

[scanner]
# Directory where to save XML, JSON and database
output_dir = ./results

# Seconds between MeterpreterMonitor polls
monitor_interval = 5

# Extra seconds to wait after pipeline completion,
# to capture staged payloads with variable connection times
post_pipeline_wait = 10

[database]
path = ./results/scanner.db
